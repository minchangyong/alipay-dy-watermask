/* 全局样式 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #0a0a0f 0%, #1a1a2e 30%, #16213e 70%, #0f3460 100%);
  position: relative;
  overflow-x: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
}

/* 动态背景元素 */
.background-elements {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 1;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 255, 255, 0.1) 0%, rgba(0, 255, 255, 0) 70%);
  filter: blur(40rpx);
  animation: float 20s infinite linear;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  top: 10%;
  left: 5%;
  background: radial-gradient(circle, rgba(0, 200, 255, 0.15) 0%, rgba(0, 200, 255, 0) 70%);
  animation-delay: 0s;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  top: 60%;
  right: 10%;
  background: radial-gradient(circle, rgba(255, 0, 200, 0.1) 0%, rgba(255, 0, 200, 0) 70%);
  animation-delay: 5s;
  animation-duration: 25s;
}

.circle-3 {
  width: 500rpx;
  height: 500rpx;
  bottom: 10%;
  left: 20%;
  background: radial-gradient(circle, rgba(0, 150, 255, 0.08) 0%, rgba(0, 150, 255, 0) 70%);
  animation-delay: 10s;
  animation-duration: 30s;
}

.bg-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    linear-gradient(rgba(0, 255, 255, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 255, 255, 0.05) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
  opacity: 0.3;
  mask-image: radial-gradient(circle at center, black 20%, transparent 70%);
}

@keyframes float {
  0%, 100% {
    transform: translate(0, 0) rotate(0deg);
  }
  25% {
    transform: translate(100rpx, 50rpx) rotate(90deg);
  }
  50% {
    transform: translate(50rpx, 100rpx) rotate(180deg);
  }
  75% {
    transform: translate(-50rpx, 50rpx) rotate(270deg);
  }
}

/* 沉浸式头部 */
.header {
  position: relative;
  padding: 60rpx 40rpx 40rpx;
  overflow: hidden;
  z-index: 2;
  padding-top: 200rpx;
}

.header-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(180deg, 
    rgba(0, 200, 255, 0.3) 0%,
    rgba(0, 150, 255, 0.1) 30%,
    transparent 100%);
  filter: blur(40rpx);
  z-index: 1;
}

.header-content {
  position: relative;
  z-index: 2;
}

.logo-container {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.logo-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0, 198, 255, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.logo-glow {
  position: absolute;
  width: 200%;
  height: 200%;
  background: conic-gradient(from 0deg, 
    transparent 0deg, 
    rgba(255, 255, 255, 0.3) 90deg, 
    transparent 180deg, 
    transparent 360deg);
  animation: rotate 4s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.logo-text {
  font-size: 48rpx;
  z-index: 2;
}

.logo-text-container {
  display: flex;
  flex-direction: column;
}

.logo-title {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 800;
  background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 4rpx 20rpx rgba(0, 198, 255, 0.3);
  letter-spacing: 1rpx;
}

.logo-subtitle {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

.header-subtitle {
  text-align: center;
  margin-top: 20rpx;
}

.pulse-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  font-weight: 500;
  background: linear-gradient(90deg, #00c6ff, #0072ff, #00c6ff);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: textShine 3s linear infinite;
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  background-color: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

@keyframes textShine {
  0% { background-position: 0% center; }
  100% { background-position: 200% center; }
}

/* 主内容区 */
.content {
  position: relative;
  z-index: 2;
  padding: 0 40rpx 40rpx;
}

/* 进度向导 */
.process-stepper {
  position: relative;
  margin: 60rpx 0 80rpx;
}

.stepper-line {
  position: absolute;
  top: 50rpx;
  left: 15%;
  right: 15%;
  height: 4rpx;
  background: linear-gradient(90deg, 
    rgba(0, 198, 255, 0.3) 0%,
    rgba(0, 114, 255, 0.3) 50%,
    rgba(0, 198, 255, 0.3) 100%);
  background-size: 200% 100%;
  animation: lineFlow 3s linear infinite;
  z-index: 1;
  border-radius: 2rpx;
}

@keyframes lineFlow {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.step-items {
  display: flex;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex: 1;
  padding: 0 20rpx;
}

.step-outer {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.1) 0%,
    rgba(255, 255, 255, 0.05) 100%);
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.step-active .step-outer {
  background: linear-gradient(135deg, 
    rgba(0, 198, 255, 0.2) 0%,
    rgba(0, 114, 255, 0.2) 100%);
  border: 2rpx solid rgba(0, 198, 255, 0.5);
  box-shadow: 0 0 40rpx rgba(0, 198, 255, 0.4);
  transform: scale(1.1);
}

.step-inner {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, 
    rgba(40, 40, 60, 0.8) 0%,
    rgba(20, 20, 40, 0.8) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.step-active .step-inner {
  background: linear-gradient(135deg, 
    rgba(0, 198, 255, 0.3) 0%,
    rgba(0, 114, 255, 0.3) 100%);
}

.step-number {
  color: rgba(255, 255, 255, 0.6);
  font-size: 36rpx;
  font-weight: 700;
  z-index: 2;
}

.step-active .step-number {
  color: #ffffff;
  text-shadow: 0 0 20rpx rgba(0, 198, 255, 0.8);
}

.step-glow {
  position: absolute;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at center, 
    rgba(0, 198, 255, 0.4) 0%,
    rgba(0, 198, 255, 0) 70%);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.2); }
}

.step-label {
  color: rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  text-align: center;
}

.step-active .step-label {
  color: #00c6ff;
  font-weight: 600;
  text-shadow: 0 0 20rpx rgba(0, 198, 255, 0.5);
}

.step-connect {
  position: absolute;
  top: 50rpx;
  right: -60rpx;
  width: 120rpx;
  height: 4rpx;
  background: linear-gradient(90deg, 
    rgba(0, 198, 255, 0.5) 0%,
    rgba(0, 114, 255, 0.5) 100%);
  z-index: 3;
}

/* 输入卡片 */
.input-card {
  background: rgba(30, 30, 50, 0.6);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 40rpx;
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}

.input-card-focus {
  border-color: rgba(0, 198, 255, 0.5);
  box-shadow: 0 0 60rpx rgba(0, 198, 255, 0.2);
  transform: translateY(-4rpx);
}

.card-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 0%, 
    rgba(0, 198, 255, 0.1) 0%,
    transparent 70%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.input-card-focus .card-glow {
  opacity: 1;
}

.card-content {
  position: relative;
  z-index: 2;
}

.input-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  gap: 20rpx;
  flex-wrap: wrap;
}

.input-icon {
  font-size: 40rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 198, 255, 0.3));
}

.input-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(90deg, #00c6ff 0%, #0072ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.input-badge {
  background: rgba(0, 198, 255, 0.1);
  border: 1rpx solid rgba(0, 198, 255, 0.3);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  margin-left: auto;
}

.input-badge text {
  color: #00c6ff;
  font-size: 24rpx;
  font-weight: 500;
}

.url-input {
  width: 100%;
  min-height: 180rpx;
  background: rgba(20, 20, 40, 0.5);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 32rpx;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1.6;
  transition: all 0.3s ease;
  box-sizing: border-box;
  font-size: 28rpx;
}

.url-input:focus {
  border-color: rgba(0, 198, 255, 0.5);
  box-shadow: 0 0 30rpx rgba(0, 198, 255, 0.1);
  outline: none;
}

.input-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.action-clear {
  background: rgba(255, 77, 77, 0.1);
  border-color: rgba(255, 77, 77, 0.2);
  color: #ff4d4d;
}

.action-paste {
  background: rgba(0, 198, 255, 0.1);
  border-color: rgba(0, 198, 255, 0.2);
  color: #00c6ff;
}

.action-icon {
  font-size: 32rpx;
}

.input-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background: rgba(0, 198, 255, 0.05);
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 198, 255, 0.1);
}

.hint-icon {
  font-size: 28rpx;
  color: #00c6ff;
}

.input-hint text:last-child {
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
}

/* 解析按钮 */
.parse-button-container {
  position: relative;
  margin: 60rpx 0 40rpx;
  display: grid;
  grid-template: 1fr 1fr / 1fr 1fr;
  gap: 20rpx;
}

.parse-button-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 120%;
  height: 200%;
  background: radial-gradient(ellipse at center, 
    rgba(0, 198, 255, 0.3) 0%,
    rgba(0, 114, 255, 0.2) 30%,
    transparent 70%);
  filter: blur(40rpx);
  z-index: 1;
  animation: glowPulse 2s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

.parse-button {
  position: relative;
  z-index: 2;
  background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 114, 255, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.parse-button.active {
  background: #DDD;
}

.parse-button-loading {
  background: linear-gradient(135deg, #0072ff 0%, #0052cc 100%);
}

.button-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.button-icon {
  font-size: 48rpx;
  animation: rocketBounce 1s ease-in-out infinite;
}

@keyframes rocketBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.button-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top: 4rpx solid #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.button-text {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 2rpx;
}

.button-subtext {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  font-weight: 500;
  display: block;
}

/* 加载动画 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 10, 15, 0.9);
  backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-modal {
  background: rgba(30, 30, 50, 0.8);
  backdrop-filter: blur(30rpx);
  border-radius: 40rpx;
  padding: 60rpx;
  border: 1rpx solid rgba(0, 198, 255, 0.2);
  box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, 0.5);
  animation: modalAppear 0.3s ease-out;
}

@keyframes modalAppear {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

.neural-loading {
  text-align: center;
}

.neural-dots {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.neural-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
  animation: neuralWave 1.5s ease-in-out infinite;
}

.dot-1 { animation-delay: 0s; }
.dot-2 { animation-delay: 0.2s; }
.dot-3 { animation-delay: 0.4s; }
.dot-4 { animation-delay: 0.6s; }

@keyframes neuralWave {
  0%, 100% { transform: translateY(0); opacity: 0.3; }
  50% { transform: translateY(-20rpx); opacity: 1; }
}

.loading-text {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: block;
  background: linear-gradient(90deg, #00c6ff, #0072ff, #00c6ff);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: textShine 2s linear infinite;
}

.loading-subtext {
  color: rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
  display: block;
}

/* 结果卡片 */
.result-card {
  background: rgba(30, 30, 50, 0.8);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 40rpx;
  margin-top: 40rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4);
  animation: slideUp 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.result-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 50%, 
    rgba(0, 198, 255, 0.1) 0%,
    transparent 70%);
  opacity: 0.5;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 2;
}

.result-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(0, 255, 128, 0.1);
  border: 1rpx solid rgba(0, 255, 128, 0.3);
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
}

.badge-icon {
  font-size: 32rpx;
  animation: badgePulse 2s infinite;
}

@keyframes badgePulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.badge-text {
  color: #00ff80;
  font-size: 28rpx;
  font-weight: 600;
}

.result-quality {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  font-weight: 500;
}

.quality-icon {
  font-size: 24rpx;
}

/* 视频预览 */
.video-preview-container {
  margin-bottom: 40rpx;
  position: relative;
}

.preview-frame {
  width: 100%;
  height: 400rpx;
  background: #000000;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.preview-corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid rgba(0, 198, 255, 0.5);
  z-index: 2;
}

.corner-tl {
  top: 10rpx;
  left: 10rpx;
  border-right: none;
  border-bottom: none;
  border-top-left-radius: 10rpx;
}

.corner-tr {
  top: 10rpx;
  right: 10rpx;
  border-left: none;
  border-bottom: none;
  border-top-right-radius: 10rpx;
}

.corner-bl {
  bottom: 10rpx;
  left: 10rpx;
  border-right: none;
  border-top: none;
  border-bottom-left-radius: 10rpx;
}

.corner-br {
  bottom: 10rpx;
  right: 10rpx;
  border-left: none;
  border-top: none;
  border-bottom-right-radius: 10rpx;
}

.preview-video {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.video-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

.placeholder-icon {
  font-size: 120rpx;
  color: rgba(0, 198, 255, 0.3);
  margin-bottom: 20rpx;
  animation: placeholderPulse 2s infinite;
}

@keyframes placeholderPulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.5; }
}

.placeholder-text {
  color: rgba(255, 255, 255, 0.5);
  font-size: 28rpx;
}

.preview-overlay {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  gap: 10rpx;
}

.overlay-badge {
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(0, 198, 255, 0.5);
  border-radius: 12rpx;
  padding: 6rpx 12rpx;
  color: #00c6ff;
  font-size: 20rpx;
  font-weight: 600;
}

/* 视频信息卡片 */
.video-info-card {
  background: rgba(20, 20, 40, 0.6);
  border-radius: 20rpx;
  padding: 16rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.info-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.info-actions {
  display: flex;
  gap: 12rpx;
}

.info-action-btn {
  background: rgba(0, 198, 255, 0.1);
  border: 1rpx solid rgba(0, 198, 255, 0.3);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  color: #00c6ff;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.info-label {
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.info-value {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  word-break: break-all;
}

.info-value.multiline {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.info-value.highlight {
  color: #00ff80;
  font-weight: 600;
}

/* 操作按钮组 */
.action-buttons {
  display: grid;
  grid-template-columns: 2fr 2fr;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-button {
  position: relative;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  cursor: pointer;
}

.action-button.primary {
  background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
  border: 2rpx solid rgba(0, 198, 255, 0.5);
}

.action-button.secondary {
  background: rgba(40, 40, 60, 0.8);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.action-button.tertiary {
  background: rgba(60, 60, 80, 0.6);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.button-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at center, 
    rgba(255, 255, 255, 0.2) 0%,
    transparent 70%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.action-button.primary .button-glow {
  opacity: 0.5;
}

.button-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 2;
}

.button-icon {
  font-size: 40rpx;
}

.button-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  z-index: 2;
}

.button-hint {
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  font-weight: 500;
  z-index: 2;
}

/* 成功提示 */
.success-toast {
  position: fixed;
  bottom: 200rpx;
  left: 50%;
  transform: translateX(-50%) translateY(100rpx);
  background: rgba(0, 200, 83, 0.9);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(0, 255, 128, 0.3);
  border-radius: 20rpx;
  padding: 24rpx 40rpx;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 1001;
  box-shadow: 0 10rpx 40rpx rgba(0, 200, 83, 0.3);
}

.success-toast.show {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
}

.toast-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.toast-icon {
  font-size: 32rpx;
  animation: iconBounce 0.5s ease;
}

@keyframes iconBounce {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

.toast-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

/* 功能说明 */
.feature-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 60rpx;
}

.feature-card {
  background: rgba(30, 30, 50, 0.5);
  border-radius: 20rpx;
  padding: 32rpx 20rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  transition: all 0.3s ease;
}

.feature-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.3);
  border-color: rgba(0, 198, 255, 0.2);
}

.feature-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 16rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 198, 255, 0.3));
}

.feature-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  display: block;
}

.feature-desc {
  color: rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
  display: block;
}

/* 客服按钮 */
.service-button {
  position: fixed;
  right: 0;
  bottom: 100rpx;
  transform: translateY(-50%);
  background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
  border-radius: 30rpx 0 0 30rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 114, 255, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-right: none;
  z-index: 999;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.service-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at center, 
    rgba(255, 255, 255, 0.2) 0%,
    transparent 70%);
  border-radius: 30rpx 0 0 30rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.service-icon {
  font-size: 36rpx;
  z-index: 2;
}

.service-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  z-index: 2;
  white-space: nowrap;
}

/* 页脚 */
.footer {
  padding: 40rpx 20rpx;
  text-align: center;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.footer-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.footer-text {
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
  font-weight: 500;
}

.footer-links {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.footer-link {
  color: rgba(0, 198, 255, 0.6);
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.footer-separator {
  color: rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
}

.footer-notice {
  color: rgba(255, 77, 77, 0.6);
  font-size: 22rpx;
  font-weight: 500;
  margin-top: 10rpx;
}

/* 交互效果 */
.btn-hover:active {
  opacity: 0.8;
  transform: scale(0.95);
}

.btn-scale:active {
  transform: scale(0.95);
}

.btn-press:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 响应式调整 */
@media screen and (max-width: 750rpx) {
  .header {
    padding: 40rpx 30rpx 30rpx;
  }
  
  .logo-container {
    gap: 20rpx;
  }
  
  .logo-icon {
    width: 80rpx;
    height: 80rpx;
  }
  
  .logo-title {
    font-size: 36rpx;
  }
  
  .logo-subtitle {
    font-size: 20rpx;
  }
  
  .pulse-text {
    font-size: 24rpx;
  }
  
  .content {
    padding: 0 30rpx 30rpx;
  }
  
  .process-stepper {
    margin: 40rpx 0 60rpx;
  }
  
  .step-item {
    padding: 0 10rpx;
  }
  
  .step-outer {
    width: 80rpx;
    height: 80rpx;
  }
  
  .step-inner {
    width: 60rpx;
    height: 60rpx;
  }
  
  .step-number {
    font-size: 28rpx;
  }
  
  .step-label {
    font-size: 24rpx;
  }
  
  .input-card {
    padding: 30rpx;
  }
  
  .input-title {
    font-size: 32rpx;
  }
  
  .url-input {
    min-height: 140rpx;
    font-size: 28rpx;
    padding: 24rpx;
  }
  
  .parse-button {
    /* padding: 30rpx; */
  }
  
  .button-text {
    font-size: 36rpx;
  }
  
  .action-buttons {
    grid-template-columns: 1fr;
  }
  
  .feature-cards {
    grid-template-columns: 1fr;
    gap: 20rpx;
  }
  
  .service-button {
    padding: 16rpx 20rpx;
  }
  
  .service-text {
    display: none;
  }
}
